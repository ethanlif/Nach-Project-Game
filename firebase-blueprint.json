{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "Represents a multiplayer game session.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "4-digit join code"
        },
        "status": {
          "type": "string",
          "enum": ["LOBBY", "ALLIANCE", "TREK", "CRISIS", "MIRACLE", "AMBUSH", "CROSSROADS", "END"],
          "description": "Current phase of the game"
        },
        "hostId": {
          "type": "string",
          "description": "UID of the host player"
        },
        "gameState": {
          "type": "object",
          "properties": {
            "stamina": { "type": "number" },
            "water": { "type": "number" },
            "allianceIntegrity": { "type": "number" },
            "currentPhase": { "type": "string" },
            "phaseStartTime": { "type": "number" },
            "strategiesLocked": { "type": "object" },
            "crisisResolved": { "type": "boolean" },
            "ambushTaps": { "type": "number" },
            "ambushSuccess": { "type": "boolean" },
            "votesEradicate": { "type": "number" },
            "votesWithdraw": { "type": "number" },
            "endState": { "type": "string" },
            "lastAction": { "type": "string" }
          },
          "required": ["stamina", "water", "allianceIntegrity", "currentPhase"]
        },
        "playersCount": {
          "type": "number"
        }
      },
      "required": ["code", "status", "hostId", "gameState", "playersCount"]
    },
    "Player": {
      "title": "Player",
      "description": "Represents a player in a room.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "team": { "type": "string", "enum": ["YISRAEL", "YEHUDAH", "EDOM", null] },
        "strategy": { "type": "string", "enum": ["CAUTIOUS", "AGGRESSIVE", "SCOUT", "UNASSIGNED"] },
        "isHost": { "type": "boolean" },
        "score": { "type": "number" }
      },
      "required": ["name", "isHost", "score", "strategy"]
    }
  },
  "firestore": {
    "rooms/{roomId}": {
      "schema": "Room",
      "description": "Primary room configuration"
    },
    "rooms/{roomId}/players/{playerId}": {
      "schema": "Player",
      "description": "Players within a room"
    }
  }
}
