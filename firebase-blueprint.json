{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "Represents a multiplayer game session.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "4-digit join code"
        },
        "status": {
          "type": "string",
          "enum": ["LOBBY", "REBELLION", "CRISIS", "MIRACLE", "VICTORY", "END"],
          "description": "Current phase of the game"
        },
        "hostId": {
          "type": "string",
          "description": "UID of the host player"
        },
        "gameState": {
          "type": "object",
          "properties": {
            "stamina": { "type": "number" },
            "water": { "type": "number" },
            "morale": { "type": "number" },
            "currentPhase": { "type": "string" },
            "phaseStartTime": { "type": "number" },
            "allianceBuilt": { "type": "boolean" },
            "crisisSolved": { "type": "boolean" },
            "miracleTriggered": { "type": "boolean" },
            "victoryAchieved": { "type": "boolean" },
            "lastAction": { "type": "string" }
          },
          "required": ["stamina", "water", "morale", "currentPhase"]
        },
        "playersCount": {
          "type": "number"
        }
      },
      "required": ["code", "status", "hostId", "gameState", "playersCount"]
    },
    "Player": {
      "title": "Player",
      "description": "Represents a player in a room.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "team": { "type": "string", "enum": ["YISRAEL", "YEHUDAH", "EDOM", null] },
        "role": { "type": "string", "enum": ["SCOUT", "WATER_BEARER", "TACTICIAN", "UNASSIGNED"] },
        "isHost": { "type": "boolean" },
        "score": { "type": "number" },
        "lastPing": { "type": "number" }
      },
      "required": ["name", "isHost", "score", "role"]
    }
  },
  "firestore": {
    "rooms/{roomId}": {
      "schema": "Room",
      "description": "Primary room configuration"
    },
    "rooms/{roomId}/players/{playerId}": {
      "schema": "Player",
      "description": "Players within a room"
    }
  }
}
